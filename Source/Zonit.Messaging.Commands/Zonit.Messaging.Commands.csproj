<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    
    <!-- Package-specific metadata -->
    <PackageId>Zonit.Messaging.Commands</PackageId>
    <Title>Zonit.Messaging.Commands</Title>
    <Description>CQRS command and query handling with strongly-typed request/response patterns. Part of Zonit.Messaging - a lightweight library for event-driven and CQRS architectures with full AOT/Trimming support.</Description>
    <PackageTags>cqrs;commands;queries;mediator;messaging;async;aot;trimming;source-generator</PackageTags>
  </PropertyGroup>
  
  <!-- Source Generator as Analyzer -->
  <ItemGroup>
    <ProjectReference Include="..\Zonit.Messaging.Commands.SourceGenerators\Zonit.Messaging.Commands.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  
  <!-- For NuGet package: include the analyzer DLL -->
  <ItemGroup>
    <None Include="..\Zonit.Messaging.Commands.SourceGenerators\bin\$(Configuration)\netstandard2.0\Zonit.Messaging.Commands.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Zonit.Messaging.Commands.Abstractions\Zonit.Messaging.Commands.Abstractions.csproj" />
  </ItemGroup>
  
  <!--
    AI context delivery: ship the MSBuild installer + instruction docs inside the package so a
    consumer's AI assistant auto-learns this library at build time. See
    buildTransitive/Zonit.Messaging.targets. The per-package stub auto-imports and pulls in the
    shared installer once even when several Zonit.Messaging.* packages are installed.
  -->
  <ItemGroup Label="AI context delivery">
    <None Include="..\buildTransitive\Zonit.Messaging.Commands.targets" Pack="true" PackagePath="buildTransitive\Zonit.Messaging.Commands.targets" />
    <None Include="..\buildTransitive\Zonit.Messaging.targets" Pack="true" PackagePath="buildTransitive\Zonit.Messaging.targets" />
    <None Include="..\..\Instruction\*.md" Exclude="..\..\Instruction\README.md" Pack="true" PackagePath="Instruction\messaging" />
  </ItemGroup>
</Project>
