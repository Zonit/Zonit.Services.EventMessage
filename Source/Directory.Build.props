<Project>
  <!-- Inherit any higher-level Directory.Build.props (e.g. the Zonit.Sdk workspace root) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="'$([MSBuild]::GetPathOfFileAbove(`Directory.Build.props`, `$(MSBuildThisFileDirectory)../`))' != ''" />

  <!-- Common NuGet Package Metadata for all Zonit.Messaging packages -->
  <PropertyGroup>
    <!--
      Stable release will be 10.0.0 (drop VersionSuffix). Kept as VersionPrefix + VersionSuffix
      so MSBuild derives a numeric AssemblyVersion/FileVersion and the netstandard2.0 source
      generators do not trip CS7034 on the prerelease suffix.
    -->
    <VersionPrefix>10.0.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>

    <Authors>Zonit</Authors>
    <Company>Zonit</Company>
    <Product>Zonit.Messaging</Product>
    <Copyright>Copyright (c) Zonit</Copyright>

    <!-- Repository and Project URLs -->
    <PackageProjectUrl>https://github.com/Zonit/Zonit.Services.EventMessage</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Zonit/Zonit.Services.EventMessage</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/Zonit/Zonit.Services.EventMessage/releases</PackageReleaseNotes>

    <!-- Build settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- AOT and Trimming support (not for Source Generators) -->
    <IsTrimmable Condition="'$(IsRoslynComponent)' != 'true'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(IsRoslynComponent)' != 'true'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- Language settings - only for non-SourceGenerator projects -->
  <PropertyGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>