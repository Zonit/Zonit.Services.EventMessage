<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    
    <!-- Package-specific metadata -->
    <PackageId>Zonit.Messaging.Events</PackageId>
    <Title>Zonit.Messaging.Events</Title>
    <Description>High-performance pub/sub event system with fan-out support and transaction handling. Part of Zonit.Messaging - a lightweight library for event-driven and CQRS architectures with full AOT/Trimming support.</Description>
    <PackageTags>events;pub-sub;messaging;async;event-driven;cqrs;aot;trimming;source-generator</PackageTags>
  </PropertyGroup>
  
  <!-- Source Generator as Analyzer -->
  <ItemGroup>
    <ProjectReference Include="..\Zonit.Messaging.Events.SourceGenerators\Zonit.Messaging.Events.SourceGenerators.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  
  <!-- For NuGet package: include the analyzer DLL -->
  <ItemGroup>
    <None Include="..\Zonit.Messaging.Events.SourceGenerators\bin\$(Configuration)\netstandard2.0\Zonit.Messaging.Events.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Zonit.Messaging.Events.Abstractions\Zonit.Messaging.Events.Abstractions.csproj" />
  </ItemGroup>

  <!--
    AI context delivery: ship the MSBuild installer + instruction docs inside the package so a
    consumer's AI assistant auto-learns this library at build time. See
    buildTransitive/Zonit.Messaging.targets. The per-package stub auto-imports and pulls in the
    shared installer once even when several Zonit.Messaging.* packages are installed.
  -->
  <ItemGroup Label="AI context delivery">
    <None Include="..\buildTransitive\Zonit.Messaging.Events.targets" Pack="true" PackagePath="buildTransitive\Zonit.Messaging.Events.targets" />
    <None Include="..\buildTransitive\Zonit.Messaging.targets" Pack="true" PackagePath="buildTransitive\Zonit.Messaging.targets" />
    <None Include="..\..\Instruction\*.md" Exclude="..\..\Instruction\README.md" Pack="true" PackagePath="Instruction\messaging" />
  </ItemGroup>
</Project>
