<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    
    <!-- Package-specific metadata -->
    <PackageId>Zonit.Messaging.Schedules.Abstractions</PackageId>
    <Title>Zonit.Messaging.Schedules.Abstractions</Title>
    <Description>Abstractions and interfaces for Zonit.Messaging.Schedules - a scheduled job processing library with cron-like and interval-based scheduling.</Description>
    <PackageTags>schedules;scheduler;cron;jobs;abstractions;interfaces;messaging</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zonit.Messaging.Schedules" />
  </ItemGroup>

  <!-- Local Development Mode: Use ProjectReference (when IsZonitSdkWorkspace == 'true') -->
  <ItemGroup Condition="'$(IsZonitSdkWorkspace)' == 'true'">
    <ProjectReference Include="..\..\..\..\Extensions\Zonit.Extensions\Source\Zonit.Extensions\Zonit.Extensions.csproj" />
  </ItemGroup>

  <!-- Production Mode: Use PackageReference (when IsZonitSdkWorkspace is NOT 'true') -->
  <ItemGroup Condition="'$(IsZonitSdkWorkspace)' != 'true'">
    <PackageReference Include="Zonit.Extensions" />
  </ItemGroup>
 
</Project>
